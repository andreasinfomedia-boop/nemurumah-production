<%- include('partials/header',{title:'Akun Admin — NemuRumah'}) %><section class="section"><div class="wrap" style="max-width:650px"><div class="box"><h1 style="font-size:34px">Akun Admin</h1><p>Ubah password admin secara berkala.</p><% if(error){ %><div class="flash" style="background:#fff0f0;color:#9b2226;border-color:#f2b5b5"><%= error %></div><% } %><% if(success){ %><div class="flash"><%= success %></div><% } %><form method="post" action="/admin/account"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Password saat ini</label><input class="input" name="current_password" type="password" required style="margin:6px 0 14px"><label>Password baru</label><input class="input" name="new_password" type="password" minlength="12" required style="margin:6px 0 14px"><label>Konfirmasi password baru</label><input class="input" name="confirm_password" type="password" minlength="12" required style="margin:6px 0 18px"><button class="btn gold">Ubah Password</button> <a class="btn light" href="/admin">Kembali</a></form></div></div></section><%- include('partials/footer') %>