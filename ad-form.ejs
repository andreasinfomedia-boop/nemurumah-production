<%- include('partials/header',{title:'Pasang Iklan Properti — NemuRumah'}) %><section class="section"><div class="wrap" style="max-width:850px"><div class="box"><h1 style="font-size:38px">Pasang Iklan Properti</h1><p>Kirim data properti Anda. Tim NemuRumah akan menghubungi untuk verifikasi sebelum ditayangkan.</p><% if(success){ %><div class="flash">Terima kasih. Data properti sudah masuk dan menunggu verifikasi admin.</div><% } %><form method="post" action="/pasang-iklan"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="formgrid"><div><label>Nama pemilik</label><input class="input" name="owner_name" required></div><div><label>No. WhatsApp</label><input class="input" name="phone" required></div><div><label>Email</label><input class="input" name="email" type="email"></div><div><label>Nama properti</label><input class="input" name="property_title" required></div><div><label>Tipe</label><select class="select" name="property_type"><option>Rumah</option><option>Apartemen</option><option>Tanah</option><option>Ruko</option></select></div><div><label>Dijual / Disewa</label><select class="select" name="purpose"><option>Dijual</option><option>Disewa</option></select></div><div><label>Lokasi</label><input class="input" name="location" required></div><div><label>Harga</label><input class="input" name="price" type="number"></div><div class="full"><label>Deskripsi dan detail</label><textarea class="input" name="description" rows="7"></textarea></div></div><button class="btn gold" style="margin-top:18px">Kirim Pengajuan</button></form></div></div></section><%- include('partials/footer') %>
