<%- include('partials/header',{title:'Admin — NemuRumah'}) %><div class="adminbar"><div class="wrap"><strong>Dashboard Admin</strong> — <%= user.name %></div></div><section class="section"><div class="wrap"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px"><div><h1 style="font-size:35px">Kelola Properti</h1><p>Tambah, edit, foto, dan hapus listing.</p></div><a class="btn gold" href="/admin/properti/new">+ Tambah Listing</a></div><div class="tablewrap"><table class="table"><thead><tr><th>Properti</th><th>Tipe</th><th>Status</th><th>Harga</th><th>Lokasi</th><th>Aksi</th></tr></thead><tbody><% props.forEach(p=>{ %><tr><td><strong><%= p.title %></strong></td><td><%= p.type %></td><td><span class="tag"><%= p.purpose %></span></td><td><%= p.price_label||('Rp '+Number(p.price).toLocaleString('id-ID')) %></td><td><%= p.location %></td><td><a class="btn light" href="/admin/properti/<%= p.id %>/edit">Edit</a> <a class="btn" href="/properti/<%= p.id %>" target="_blank">Lihat</a><form method="post" action="/admin/properti/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Hapus listing ini?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn red">Hapus</button></form></td></tr><% }) %></tbody></table></div><div style="margin-top:40px"><h2>Form Pemasangan Iklan</h2><div class="tablewrap"><table class="table"><thead><tr><th>Pemilik</th><th>Properti</th><th>Kontak</th><th>Lokasi</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><%= r.owner_name %></td><td><%= r.property_title %></td><td><%= r.phone %></td><td><%= r.location %></td><td><%= r.status %></td><td><form method="post" action="/admin/request/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="status"><option>new</option><option>contacted</option><option>approved</option><option>rejected</option></select> <button class="btn light">Update</button></form></td></tr><% }) %></tbody></table></div></div></div></section><%- include('partials/footer') %>
