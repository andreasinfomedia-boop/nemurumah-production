<%- include('partials/header',{title:p.title+' — NemuRumah'}) %><section class="section"><div class="wrap"><div class="gallery"><% if(p.images.length){p.images.forEach(i=>{ %><img src="/uploads/<%= i.filename %>" alt="<%= p.title %>"><% }) }else{ %><div class="photo" style="height:448px;grid-column:1/-1">Foto properti belum tersedia</div><% } %></div><div class="detailgrid" style="margin-top:22px"><div><div class="box"><span class="tag"><%= p.purpose %></span><h1 style="font-size:35px;margin-top:10px"><%= p.title %></h1><p>📍 <%= p.address || p.location %></p><div class="price"><%= p.price_label || ('Rp '+Number(p.price).toLocaleString('id-ID')) %></div><div class="meta"><span>🛏 <%= p.bedrooms %> kamar</span><span>🛁 <%= p.bathrooms %> kamar mandi</span><span>🌳 LT <%= p.land_area %> m²</span><span>🏠 LB <%= p.building_area %> m²</span></div><hr><h2>Deskripsi</h2><p><%= p.description || 'Belum ada deskripsi.' %></p></div><div class="box" style="margin-top:18px"><h2>Lokasi</h2><p><%= p.address || p.location %></p><% if(p.latitude&&p.longitude){ %><iframe class="map" loading="lazy" src="https://www.google.com/maps?q=<%= p.latitude %>,<%= p.longitude %>&output=embed"></iframe><p><a class="btn light" target="_blank" href="https://www.google.com/maps/search/?api=1&query=<%= p.latitude %>,<%= p.longitude %>">Buka Google Maps ↗</a></p><% }else{ %><p>Koordinat belum diisi oleh admin.</p><% } %></div></div><aside><div class="box" style="position:sticky;top:90px"><h2>Tertarik?</h2><p>Hubungi NemuRumah untuk informasi dan jadwal survei.</p><a class="btn gold" style="display:block;text-align:center" target="_blank" href="https://wa.me/<%= p.whatsapp || wa %>?text=<%= encodeURIComponent('Halo NemuRumah, saya tertarik dengan '+p.title+'. Mohon info lebih lanjut.') %>">WhatsApp Sekarang 💬</a></div></aside></div></div></section><%- include('partials/footer') %>
