<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title||'NemuRumah' %></title><style>
:root{--n:#0d315f;--g:#f6a916;--bg:#f6f8fb;--mut:#6d7788}*{box-sizing:border-box}body{margin:0;font-family:Inter,Arial,sans-serif;color:#172033;background:var(--bg)}a{text-decoration:none;color:inherit}.wrap{width:min(1150px,92%);margin:auto}.nav{height:70px;background:#fff;border-bottom:1px solid #e8edf3;display:flex;align-items:center;justify-content:space-between}.logo{font-size:23px;font-weight:900;color:var(--n)}.logo b{color:var(--g)}.navlinks{display:flex;gap:18px;font-size:14px;font-weight:700;align-items:center}.btn{border:0;background:var(--n);color:#fff;padding:11px 16px;border-radius:10px;font-weight:800;cursor:pointer}.btn.gold{background:var(--g)}.btn.red{background:#d9363e}.btn.light{background:#edf3fa;color:var(--n)}.hero{padding:60px 0;background:linear-gradient(135deg,#fff8e8,#fff)}h1{font-size:48px;line-height:1.05;color:var(--n);margin:0 0 14px}h1 span{color:var(--g)}h2{color:var(--n)}p{color:var(--mut)}.search{display:grid;grid-template-columns:2fr 1fr 1fr auto;gap:8px;background:#fff;padding:10px;border-radius:15px;box-shadow:0 10px 30px #0d315f16}.input,.select,textarea{width:100%;border:1px solid #dfe5ed;border-radius:9px;padding:12px;font:inherit;background:#fff}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:#fff;border-radius:17px;overflow:hidden;border:1px solid #e9edf2}.photo{height:185px;background:#e9f2fb;display:flex;align-items:center;justify-content:center;color:#8ba0b8;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover}.body{padding:16px}.price{font-weight:900;color:var(--n);font-size:20px}.meta{font-size:12px;color:var(--mut);display:flex;gap:10px;margin:9px 0}.tag{font-size:11px;background:#fff1ca;color:#805600;padding:4px 8px;border-radius:10px;font-weight:800;display:inline-block}.section{padding:50px 0}.detailgrid{display:grid;grid-template-columns:1.4fr .6fr;gap:24px}.box{background:#fff;border:1px solid #e8edf2;border-radius:16px;padding:22px}.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px}.gallery img{width:100%;height:220px;object-fit:cover;border-radius:12px}.gallery img:first-child{grid-row:span 2;height:448px}.map{width:100%;height:330px;border:0;border-radius:12px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.full{grid-column:1/-1}.adminbar{background:var(--n);color:#fff;padding:18px 0}.tablewrap{overflow:auto;background:#fff;border-radius:15px}.table{width:100%;border-collapse:collapse;min-width:850px}.table th,.table td{padding:12px;border-bottom:1px solid #edf0f4;text-align:left;font-size:13px}.flash{padding:12px 15px;background:#e8f8ec;border:1px solid #b8e3c1;color:#216b2f;border-radius:10px;margin-bottom:18px}.footer{padding:35px 0;background:#071d39;color:#cbd7e6;margin-top:50px}.footer p{color:#9eb0c6}@media(max-width:800px){.search,.cards,.detailgrid,.formgrid{grid-template-columns:1fr}.gallery{grid-template-columns:1fr 1fr}.gallery img:first-child{grid-column:1/-1;grid-row:auto;height:260px}.gallery img{height:150px}.navlinks a:not(.btn){display:none}h1{font-size:39px}}
</style></head><body><header class="nav"><div class="wrap" style="display:flex;align-items:center;justify-content:space-between;width:92%"><a class="logo" href="/">Nemu<b>Rumah</b></a><nav class="navlinks"><a href="/">Properti</a><a href="/pasang-iklan">Pasang Iklan</a><% if(user){ %><a href="/admin">Admin</a><a href="/admin/account">Akun</a><form method="post" action="/logout" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn light">Keluar</button></form><% }else{ %><a class="btn" href="/login">Login Admin</a><% } %></nav></div></header>
