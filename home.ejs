<%- include('partials/header',{title:'NemuRumah — Ketemu Rumah, Ketemu Bahagia'}) %>
<section class="hero"><div class="wrap"><div style="max-width:760px"><div class="tag">🏠 AGENCY PROPERTI</div><h1>Ketemu Rumah,<br><span>Ketemu Bahagia.</span></h1><p>Temukan rumah, apartemen, tanah, dan properti pilihan dengan informasi yang jelas.</p></div><form class="search" method="get" action="/"><input class="input" name="q" value="<%= q %>" placeholder="Cari lokasi, nama properti..."><select class="select" name="type"><option value="">Tipe</option><option <%= type==='Rumah'?'selected':'' %>>Rumah</option><option <%= type==='Apartemen'?'selected':'' %>>Apartemen</option><option <%= type==='Tanah'?'selected':'' %>>Tanah</option><option <%= type==='Ruko'?'selected':'' %>>Ruko</option></select><select class="select" name="purpose"><option value="">Dijual / Disewa</option><option <%= purpose==='Dijual'?'selected':'' %>>Dijual</option><option <%= purpose==='Disewa'?'selected':'' %>>Disewa</option></select><button class="btn gold">🔎 Cari</button></form></div></section>
<section class="section"><div class="wrap"><div style="display:flex;justify-content:space-between;align-items:end;margin-bottom:22px"><div><h2>Properti Pilihan</h2><p>Pilihan hunian yang tersedia.</p></div><a href="/pasang-iklan" class="btn light">Pasang Properti</a></div><div class="cards"><% props.forEach(p=>{ %><a class="card" href="/properti/<%= p.id %>"><div class="photo"><% if(p.images&&p.images[0]){ %><img src="/uploads/<%= p.images[0].filename %>" alt="<%= p.title %>"><% }else{ %>Foto properti belum tersedia<% } %></div><div class="body"><span class="tag"><%= p.purpose %></span><h3><%= p.title %></h3><div class="price"><%= p.price_label || ('Rp '+Number(p.price).toLocaleString('id-ID')) %></div><div class="meta"><span>📍 <%= p.location %></span><span>🛏 <%= p.bedrooms %></span><span>🛁 <%= p.bathrooms %></span></div></div></a><% }) %></div><% if(!props.length){ %><div class="box">Properti belum ditemukan. Coba kata kunci atau filter lain.</div><% } %></div></section>
<section class="section" style="background:#fff"><div class="wrap"><h2>Kenapa NemuRumah?</h2><div class="cards"><div class="box"><h3>🔎 Listing Jelas</h3><p>Harga, lokasi, spesifikasi dan foto tersedia dalam satu halaman.</p></div><div class="box"><h3>🤝 Konsultasi</h3><p>Hubungi tim NemuRumah untuk kebutuhan jual, beli, atau sewa.</p></div><div class="box"><h3>📍 Lokasi</h3><p>Setiap listing dapat dilengkapi koordinat dan peta.</p></div></div></div></section>
<%- include('partials/footer') %>
