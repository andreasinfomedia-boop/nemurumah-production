<%- include('partials/header',{title:(p?'Edit':'Tambah')+' Properti — NemuRumah'}) %><section class="section"><div class="wrap"><div class="box"><h1 style="font-size:34px"><%= p?'Edit':'Tambah' %> Listing Properti</h1><form method="post" action="<%= action %>" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="formgrid"><div><label>Judul</label><input class="input" name="title" required value="<%= p?p.title:'' %>"></div><div><label>Tipe</label><select class="select" name="type"><% ['Rumah','Apartemen','Tanah','Ruko'].forEach(x=>{ %><option <%= p&&p.type===x?'selected':'' %>><%= x %></option><% }) %></select></div><div><label>Status transaksi</label><select class="select" name="purpose"><option <%= p&&p.purpose==='Dijual'?'selected':'' %>>Dijual</option><option <%= p&&p.purpose==='Disewa'?'selected':'' %>>Disewa</option></select></div><div><label>Harga angka</label><input class="input" name="price" type="number" value="<%= p?p.price:0 %>"></div><div><label>Tampilan harga</label><input class="input" name="price_label" placeholder="Rp 850 Juta" value="<%= p?p.price_label:'' %>"></div><div><label>Lokasi</label><input class="input" name="location" required value="<%= p?p.location:'' %>"></div><div class="full"><label>Alamat</label><input class="input" name="address" value="<%= p?p.address:'' %>"></div><div><label>Kamar tidur</label><input class="input" name="bedrooms" type="number" value="<%= p?p.bedrooms:0 %>"></div><div><label>Kamar mandi</label><input class="input" name="bathrooms" type="number" value="<%= p?p.bathrooms:0 %>"></div><div><label>Luas tanah (m²)</label><input class="input" name="land_area" type="number" value="<%= p?p.land_area:0 %>"></div><div><label>Luas bangunan (m²)</label><input class="input" name="building_area" type="number" value="<%= p?p.building_area:0 %>"></div><div><label>Latitude</label><input class="input" name="latitude" value="<%= p&&p.latitude?p.latitude:'' %>"></div><div><label>Longitude</label><input class="input" name="longitude" value="<%= p&&p.longitude?p.longitude:'' %>"></div><div><label>WhatsApp</label><input class="input" name="whatsapp" value="<%= p?p.whatsapp:'' %>"></div><div><label>Status</label><select class="select" name="status"><option value="published" <%= !p||p.status==='published'?'selected':'' %>>Published</option><option value="draft" <%= p&&p.status==='draft'?'selected':'' %>>Draft</option></select></div><div><label>Foto properti</label><input class="input" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple></div><div class="full"><label>Deskripsi</label><textarea class="input" name="description" rows="6"><%= p?p.description:'' %></textarea></div></div><button class="btn gold" style="margin-top:18px">Simpan Listing</button> <a class="btn light" href="/admin">Batal</a></form></div><% if(p&&p.images.length){ %><div class="box" style="margin-top:18px"><h2>Foto Saat Ini</h2><div class="cards"><% p.images.forEach(i=>{ %><div class="card"><div class="photo"><img src="/uploads/<%= i.filename %>"></div><div class="body"><form method="post" action="/admin/properti/<%= p.id %>/image/<%= i.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn red">Hapus Foto</button></form></div></div><% }) %></div></div><% } %></div></section><%- include('partials/footer') %>
